# AgentLoop configuration — copy to .env and edit.
#   cp .env.example .env

# Mode: cli (default) drives an external agent CLI; direct calls an OpenAI-compatible API.
AGENT_MODE=cli

# Primary harness: OpenCode (ships free models, needs no key from us).
# OpenCode is auto-detected if this is left unset; set explicitly to pin it.
AGENT_PRESET=opencode

# Other harnesses: kilocode | claude | aider | codex
# Or set AGENT_CMD to any command; the prompt is injected via $AGENTLOOP_PROMPT.
# AGENT_CMD='opencode run "$AGENTLOOP_PROMPT" --auto'

# Ground-truth verification oracle (run with cwd = project root).
# The agent can NEVER edit this, so it cannot fake success.
VERIFY_CMD="bash verify.sh"

# Optional: run the verifier every N direct-mode steps (early feedback). 0 = only on DONE.
# VERIFY_AT_STEP=0

# Optional: held-out oracle seal (passed to VERIFY_CMD only — never to the agent).
# ORACLE_SEAL=change-me-to-a-long-random-string

# Loop bounds & cost guards
MAX_ITERS=50
# WALL_CLOCK_SEC=21600
# STEP_DELAY=3
# AGENT_TIMEOUT=900
# VERIFY_TIMEOUT=120
# MAX_COST_USD=5.0
# ESTIMATED_COST_PER_ITER=0.10  # CLI mode estimated cost per iteration (direct mode tracks real token usage)

# Optional: hard goal-pattern blocking (colon or comma separated list of substrings)
# BLOCKED_GOAL_PATTERNS="rm -rf:mkfs:dd if="

# Optional: fire on terminal states. {kind} and {msg} are substituted.
# NOTIFY_CMD='curl -s -X POST https://hooks.example.com -d "{kind}: {msg}"'

# Structured JSON logging: emit one JSON line per log record (Loki/Elastic/jq friendly)
# LOG_JSON=true

# Optional telemetry (both are no-ops unless configured here):
# OpenTelemetry: set AGENTLOOP_OTEL_ENDPOINT to enable OTLP export (pip install 'agentloop[otlp]')
# AGENTLOOP_OTEL_ENDPOINT=https://api.honeycomb.io
# HONEYCOMB_API_KEY=your-honeycomb-key
# Langfuse: set both keys to enable (pip install 'agentloop[langfuse]')
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# Container isolation knobs (used with --docker / --podman):
# AGENTLOOP_DOCKER_NETWORK=none   # or 'host' for harnesses that need model API access
# AGENTLOOP_DOCKER_IMAGE=python:3.12-slim

# Direct mode only (legacy) — leave unset when using a CLI harness.
# AGENTLOOP_API_KEY=sk-...
# AGENTLOOP_BASE_URL=https://api.openai.com/v1
# AGENTLOOP_MODEL=gpt-4o-mini
# Deprecated aliases: KILO_API_KEY, KILO_BASE_URL, KILO_MODEL
